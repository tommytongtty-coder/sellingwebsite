NODE_ENV=development
PORT=3000

# ── MySQL ─────────────────────────────────────────────────────
# MAMP default port is 8889; standard MySQL installations use 3306
MYSQL_HOST=127.0.0.1
MYSQL_PORT=8889
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=marketplace

# ── Stripe (optional) ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_CLIENT_ID=ca_your_id_here
