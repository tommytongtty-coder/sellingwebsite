NODE_ENV=development
PORT=3000

# ── MySQL ─────────────────────────────────────────────────────
# Get host, port, user, password, and database name from your provider
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Set to true for remote databases that require TLS
MYSQL_SSL=true

# ── Auth ──────────────────────────────────────────────────────
# REQUIRED in production — without this, anyone can forge JWT tokens
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# ── Stripe (optional) ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_CLIENT_ID=ca_your_id_here
